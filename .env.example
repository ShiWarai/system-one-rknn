PORT=8080

# Владелец пакета GHCR в оверлеях prerelease/prod.
GHCR_OWNER=shiwarai

# npu грузит платы RK3588. fake отвечает без весов и нужен только тестам.
SYSTEM_ONE_ENGINE=npu
# Какие веса качать и поднимать при старте: laya, kev или laya,kev.
MODELS=laya,kev
MODELS_DIR=./models
LAYA_REPO=ShiWarai/laya-multilingual-rknn
KEV_REPO=ShiWarai/kev-0.8b-rknn

# Плата, под которую собран образ. Сейчас только rk3588.
# Теги GHCR: :rk3588-main, :rk3588-prerelease, :rk3588-<sha>.
BOARD=rk3588
