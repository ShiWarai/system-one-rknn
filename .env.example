PORT=8080

# Владелец пакета GHCR в оверлеях prerelease/prod.
GHCR_OWNER=shiwarai

# npu грузит RKNN/RKLLM-веса плат RK3588. cpu грузит исходные HF-веса через torch
# (laya-пакет и merged Qwen3.5+LoRA) — только в образе runtime-cpu. fake — заглушка для тестов.
SYSTEM_ONE_ENGINE=npu
# Какие веса качать и поднимать при старте: laya, kev или laya,kev.
MODELS=laya,kev
MODELS_DIR=./models
LAYA_REPO=ShiWarai/laya-multilingual-rknn
KEV_REPO=ShiWarai/kev-0.8b-rknn

# Семейство NPU-образа (рантаймы для плат RKNN/RKLLM).
# Теги GHCR: :rknn-main, :rknn-prerelease, :rknn-<sha>; CPU-образ — :cpu-<то же>.
BOARD=rknn
